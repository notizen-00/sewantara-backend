APP_NAME=Sewantara
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sewantara_app
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

CACHE_STORE=database
DB_CACHE_CONNECTION=pgsql
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sewantara-local
REVERB_APP_KEY=sewantara-local-key
REVERB_APP_SECRET=sewantara-local-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

VITE_APP_NAME=${APP_NAME}
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}

TENANT_BASE_DOMAIN=localhost
CENTRAL_DOMAIN=localhost
API_DOMAIN=localhost
TENANT_PUBLIC_WEB_ENABLED=true
TENANT_DEFAULT_TIMEZONE=Asia/Jakarta
TENANT_DEFAULT_LOCALE=id-ID
TENANT_DEFAULT_CURRENCY=IDR
BFF_SERVICE_TOKEN_CURRENT=
BFF_SERVICE_TOKEN_PREVIOUS=
INTERNAL_HEALTH_TOKEN=
TRUSTED_PROXY_IPS=
TRUSTED_BFF_IPS=
TRUSTED_HOSTS=
READINESS_CACHE_STORE=
TENANT_RESOLUTION_CACHE_STORE=
TENANT_PUBLIC_CONTENT_CACHE_STORE=
PUBLIC_IDEMPOTENCY_CACHE_STORE=
TENANT_PUBLIC_MEDIA_BASE_URL=/api/public
TENANT_RESOLUTION_CACHE_TTL=300
TENANT_PUBLIC_CONTENT_CACHE_TTL=300
TENANT_PUBLIC_CACHE_MAX_AGE=60
TENANT_PUBLIC_CACHE_SHARED_MAX_AGE=300
TENANT_PUBLIC_CACHE_STALE_WHILE_REVALIDATE=60
QUOTE_TTL_MINUTES=15
PAYMENT_TTL_MINUTES=30
STOCK_HOLD_TTL_MINUTES=20
IDEMPOTENCY_TTL_HOURS=24
TENANT_EXPIRED_SUBSCRIPTION_PUBLIC_READ=false
TENANT_GRACE_PERIOD_PUBLIC_READ=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/central/auth/google/callback
GOOGLE_AUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_AUTH_EXCHANGE_TTL=60

CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS_PATTERNS=/^http:\/\/localhost(:[0-9]+)?$/,/^http:\/\/127\.0\.0\.1(:[0-9]+)?$/
CORS_SUPPORTS_CREDENTIALS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=${APP_NAME}

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_3DS=true
XENDIT_PUBLIC_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_URL=
PAYMENT_GATEWAY=midtrans
SUBSCRIPTION_PAYMENT_GATEWAY=xendit
SUBSCRIPTION_PAYMENT_SUCCESS_URL=
SUBSCRIPTION_PAYMENT_CANCEL_URL=

LARAVEL_CACHE_CONFIG=false

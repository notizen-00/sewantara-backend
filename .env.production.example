APP_NAME=Sewantara
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_BIND_IP=0.0.0.0
APP_HTTP_PORT=8090
APP_IMAGE_TAG=latest
APP_ENV_FILE=.env.production

LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sewantara_app
DB_USERNAME=sewantara
DB_PASSWORD=change-this-database-password
DB_SSLMODE=prefer

POSTGRES_DB=sewantara_app
POSTGRES_USER=sewantara
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_BIND_IP=0.0.0.0
POSTGRES_PUBLIC_PORT=5432

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sewantara
REVERB_APP_KEY=replace-with-a-random-public-key
REVERB_APP_SECRET=replace-with-a-long-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
REVERB_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://api.example.com

REVERB_PUBLIC_HOST=api.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_PUBLIC_HOST}
VITE_REVERB_PORT=${REVERB_PUBLIC_PORT}
VITE_REVERB_SCHEME=${REVERB_PUBLIC_SCHEME}
VITE_APP_NAME=${APP_NAME}

TENANT_BASE_DOMAIN=example.com
CENTRAL_DOMAINS=api.example.com
CENTRAL_DOMAIN=example.com
API_DOMAIN=api.example.com
TENANT_PUBLIC_WEB_ENABLED=true
TENANT_DEFAULT_TIMEZONE=Asia/Jakarta
TENANT_DEFAULT_LOCALE=id-ID
TENANT_DEFAULT_CURRENCY=IDR
BFF_SERVICE_TOKEN_CURRENT=
BFF_SERVICE_TOKEN_PREVIOUS=
INTERNAL_HEALTH_TOKEN=
TRUSTED_PROXY_IPS=
TRUSTED_BFF_IPS=
TRUSTED_HOSTS=
READINESS_CACHE_STORE=redis
TENANT_RESOLUTION_CACHE_STORE=redis
TENANT_PUBLIC_CONTENT_CACHE_STORE=redis
PUBLIC_IDEMPOTENCY_CACHE_STORE=redis
TENANT_PUBLIC_MEDIA_BASE_URL=/api/public
TENANT_RESOLUTION_CACHE_TTL=300
TENANT_PUBLIC_CONTENT_CACHE_TTL=300
TENANT_PUBLIC_CACHE_MAX_AGE=60
TENANT_PUBLIC_CACHE_SHARED_MAX_AGE=300
TENANT_PUBLIC_CACHE_STALE_WHILE_REVALIDATE=60
QUOTE_TTL_MINUTES=15
PAYMENT_TTL_MINUTES=30
STOCK_HOLD_TTL_MINUTES=20
IDEMPOTENCY_TTL_HOURS=24
TENANT_EXPIRED_SUBSCRIPTION_PUBLIC_READ=false
TENANT_GRACE_PERIOD_PUBLIC_READ=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/central/auth/google/callback
GOOGLE_AUTH_FRONTEND_CALLBACK_URL=https://app.example.com/auth/google/callback
GOOGLE_AUTH_EXCHANGE_TTL=60

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS_PATTERNS=/^https:\/\/([a-z0-9-]+\.)?example\.com$/
CORS_SUPPORTS_CREDENTIALS=true

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=${APP_NAME}

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_3DS=true
XENDIT_PUBLIC_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_BASE_URL=https://api.doku.com
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_NOTIFICATION_URL=https://api.example.com/api/central/billing/doku/webhook
PAYMENT_GATEWAY=midtrans
SUBSCRIPTION_PAYMENT_GATEWAY=xendit
SUBSCRIPTION_PAYMENT_SUCCESS_URL=https://app.sewantara.id
SUBSCRIPTION_PAYMENT_CANCEL_URL=https://app.sewantara.id

LARAVEL_CACHE_CONFIG=true

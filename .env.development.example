APP_NAME=Sewantara
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8091
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_BIND_IP=127.0.0.1
APP_HTTP_PORT=8091
APP_IMAGE_TAG=development
APP_ENV_FILE=.env.development

LOG_CHANNEL=stderr
LOG_LEVEL=debug
BCRYPT_ROUNDS=10

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sewantara_app_development
DB_USERNAME=sewantara
DB_PASSWORD=sewantara-development
DB_SSLMODE=prefer

POSTGRES_DB=sewantara_app_development
POSTGRES_USER=sewantara
POSTGRES_PASSWORD=sewantara-development

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sewantara-development
REVERB_APP_KEY=sewantara-development-key
REVERB_APP_SECRET=sewantara-development-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
REVERB_ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,http://localhost:5173

REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8091
REVERB_PUBLIC_SCHEME=http
VITE_APP_NAME=${APP_NAME}
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_PUBLIC_HOST}
VITE_REVERB_PORT=${REVERB_PUBLIC_PORT}
VITE_REVERB_SCHEME=${REVERB_PUBLIC_SCHEME}

TENANT_BASE_DOMAIN=localhost
CENTRAL_DOMAINS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,http://localhost:5173
CORS_ALLOWED_ORIGINS_PATTERNS=/^http:\/\/localhost(:[0-9]+)?$/,/^http:\/\/127\.0\.0\.1(:[0-9]+)?$/
CORS_SUPPORTS_CREDENTIALS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=${APP_NAME}

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_3DS=true
XENDIT_PUBLIC_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
PAYMENT_GATEWAY=midtrans
SUBSCRIPTION_PAYMENT_GATEWAY=xendit

LARAVEL_CACHE_CONFIG=false
